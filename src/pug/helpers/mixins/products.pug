mixin mixin__poructCard(i,title, price, priceold, description, storage)
	.listcard
		a.listcard__picture(href="#")
			img(src=`${baseDir}img/catalog/img-product-${i}.jpg`, alt="")
			.markers
				if priceold
					span.marker-sale
		a.listcard__title(href="#")=title
		.listcard__description!= description
		- var storageClass = storage === 'В наличии' ? 'color-green' : (storage === 'Под заказ' ? 'color-red' : '')
		.listcard__storage(class=storageClass)=storage
		.listcard__bottom
			if priceold
				.price.price__old от <span>#{priceold}</span> ₽/м<sup>2</sup>
			if price
				.price от <span>#{price}</span> ₽/м<sup>2</sup>
