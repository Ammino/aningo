extends ../layouts/default

prepend vars

block content

	main.main(style="padding-top: 0;")
		section.block__padd: .container
			.block__text
				.row
					.col-12: a.header__logo: img(src=`${baseDir}img/header-logo.svg`, alt="Logo", style="width: 240px;")
					.col-12.gy-5
						.h4 Страницы
						ul
							li: a(href="home.html" target="_blank") Главная
							li: a(href="catalog.html" target="_blank") Каталог
							li: a(href="catalog-onix.html" target="_blank") Оникс
							li: a(href="card.html" target="_blank") Карточка товара
							li: a(href="card-offer.html" target="_blank") Торговое предложение
							li: a(href="services.html" target="_blank") Услуги
							li: a(href="portfolio.html" target="_blank") Портфолио
							li: a(href="portfolio-card.html" target="_blank") Портфолио | Карточка проекта
							li: a(href="compositions.html" target="_blank") Композиции из слэбов
							li: a(href="blog.html" target="_blank") Блог
							li: a(href="blog-article.html" target="_blank") Блог | Статья
							li: a(href="blog-article-wvideo.html" target="_blank") Блог | Статья с видео
							li: a(href="streams.html" target="_blank") Stream 24/7
							li: a(href="about.html" target="_blank") О компании
							li: a(href="for-business.html" target="_blank") Для бизнеса
					.col-12.gy-5
						.h4 Модальные окна
						ul
							li: a(href="#js--modal-recall" data-fancybox-default) Получить консультацию
							li: a(href="#js--modal-order" data-fancybox-default) Заказать услугу
							li: a(href="#js--modal-info" data-fancybox-default) Запрос отправлен
							li: a(href="#js--modal-offers" data-fancybox-offers) Слайдер торгового предложения

block modals
	include ../section/modals/modals
