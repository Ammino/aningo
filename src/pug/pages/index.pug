extends ../layouts/default

prepend vars

block content

	main.main(style="padding-top: 0;")
		section.block__padd: .container
			.block__text
				.row
					.col-12: a.header__logo: img(src=`${baseDir}img/header-logo.svg`, alt="Logo", style="width: 240px;")
					.col-12.gy-5
						.h4 Страницы
						ul
							li: a(href="home.html" target="_blank") Главная
							li: a(href="catalog.html" target="_blank") Каталог
							li: a(href="catalog-onix.html" target="_blank") Оникс
							li: a(href="card.html" target="_blank") Карточка товара
							li: a(href="card-offer.html" target="_blank") Торговое предложение
							li: a(href="catalog-products.html" target="_blank") Каталог изделий
							li: a(href="card-product.html" target="_blank") Карточка изделия
							li: a(href="card-product-offer.html" target="_blank") Торговое предложение изделия
							li: a(href="services.html" target="_blank") Услуги
							li: a(href="portfolio.html" target="_blank") Портфолио
							li: a(href="portfolio-card.html" target="_blank") Портфолио | Карточка проекта
							li: a(href="compositions.html" target="_blank") Композиции из слэбов
							li: a(href="blog.html" target="_blank") Блог
							li: a(href="blog-article.html" target="_blank") Блог | Статья
							li: a(href="blog-article-wvideo.html" target="_blank") Блог | Статья с видео
							li: a(href="contacts.html" target="_blank") Контакты
							li: a(href="about.html" target="_blank") О компании
							li: a(href="for-business.html" target="_blank") Для бизнеса
							li: a(href="for-designers.html" target="_blank") Для дизайнеров
							li: a(href="delivery-payment.html" target="_blank") Доставка и оплата
							li: a(href="streams.html" target="_blank") Stream 24/7
							li: a(href="cart.html" target="_blank") Корзина
							li: a(href="cart-nogoods.html" target="_blank") Корзина | Нет товаров
							li: a(href="page-404.html" target="_blank") Страница 404
							li: a(href="policy.html" target="_blank") Политика в отношении обработки персональных данных
							li: a(href="offerta.html" target="_blank") Оферта
							li: a(href="guarantee.html" target="_blank") Гарантия
							li: a(href="return-product.html" target="_blank") Возврат товара
							li: a(href="calculator.html" target="_blank") Калькулятор
							li: a(href="calculator-vid-1.html" target="_blank") Калькулятор | Калькулятор столешниц из натурального камня
							li: a(href="calculator-vid-2.html" target="_blank") Калькулятор | Калькулятор подоконников из натурального камня
							li: a(href="ui-kit.html" target="_blank") ui-kit
					.col-12.gy-5
						.h4 Модальные окна
						ul
							li: a(href="#js--modal-recall" data-fancybox-default) Получить консультацию
							li: a(href="#js--modal-order" data-fancybox-default) Заказать услугу
							li: a(href="#js--modal-info" data-fancybox-default) Запрос отправлен
							li: a(href="#js--modal-offers" data-fancybox-offers) Слайдер торгового предложения
							li: a(href="#js--modal-offers2" data-fancybox-offers) Слайдер торгового предложения изделия
							li: a(href="#js--modal-questionnaire" data-fancybox-offers) Для чего вы планируете использовать камень?

block modals
	include ../section/modals/modals
