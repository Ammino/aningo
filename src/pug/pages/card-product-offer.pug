extends ../layouts/default

prepend vars

block content

	// header start
	include ../section/header/header
	// header end

	// search
	include ../section/header/_search
	// /search

	main#main.main

		section.pageinside: .container
			+crumbsBlock()
				li: a.crumbs__link(href="home.html" target="_blank") Главная
				li: a.crumbs__link(href="catalog.html" target="_blank") Изделия из камня
				li: a.crumbs__link(href="catalog.html" target="_blank") Ступени
				li: a.crumbs__link(href="catalog.html" target="_blank") Ступень из гранита PIETRA ARABICA
				li: span Ступень из гранита PIETRA ARABICA

			.cardoffer
				.cardoffer__header
					h1.h1 Ступень из гранита PIETRA ARABICA
					//- h4.h4 Ступень из гранита PIETRA ARABICA

				.cardoffer__img
					.cardoffer__img__slider.swiper.js--sl-cardofferimages
						.swiper-wrapper
							.cardoffer__img__slider__item.swiper-slide
								img(src=`${baseDir}img/catalog/img-catalog3-0.png`, alt="")
							.cardoffer__img__slider__item.swiper-slide
								img(src=`${baseDir}img/catalog/img-catalog-3.png`, alt="")
							.cardoffer__img__slider__item.swiper-slide
								img(src=`${baseDir}img/catalog/img-catalog-4.webp`, alt="")
						.cardoffer__img__slider__nav
							button.cardoffer__img__slider__navbtn.prev.js--sl-cardofferimages-prev(type="button" aria-label="Предыдущее фото"): +svg('ic-arrow-left-short')
							button.cardoffer__img__slider__navbtn.next.js--sl-cardofferimages-next(type="button" aria-label="Следующее фото"): +svg('ic-arrow-right-short')
					.cardoffer__img__slider__pagination.js--sl-cardofferimages-pagination

				.cardoffer__body
					-
						var cm_property = [
							'Размер',
							'В наличии',
							'Камень',
						]
						var cm_value = [
							'3000x1400x20 мм',
							'20 шт',
							'Гранит',
						]

					.content-columns__properties__list.js--filterlist
						- for (let i = 0; i < cm_property.length; i++)
							.content-columns__properties__list__item.js--filterlist-item
								span=cm_property[i]
								span!=cm_value[i]
						- for (let i = 0; i < cm_property.length; i++)
							.content-columns__properties__list__item.js--filterlist-item
								span=cm_property[i]
								span!=cm_value[i]
						- for (let i = 0; i < cm_property.length; i++)
							.content-columns__properties__list__item.js--filterlist-item
								span=cm_property[i]
								span!=cm_value[i]

						.content-columns__properties__list__more.js--filterlist-footer.d-none
							a.content-columns__properties__list__more__link.js--filterlist-more(href="#")
								span.default Показать больше
								span.active Свернуть

					.cardoffer__footer

						.cardoffer__prices.order-1
							.cardoffer__prices__item
								.cardoffer__prices__old
									.cardoffer__prices__old__text
										span 33 000
										| &nbsp;шт
									//- .cardoffer__prices__label 140 000 ₽/шт

							.cardoffer__prices__item
								.cardoffer__prices__actual
									.cardoffer__prices__actual__text
										span 32 000
										| &nbsp;шт
									//- .cardoffer__prices__label 134 000 ₽/шт

						div.order-3.order-lg-2: a.mbtn.mbtn__primary.mbtn__middle(href="#") в корзину
						div.order-4.order-lg-3: a.mbtn.mbtn__grey.mbtn__middle(
							href="#js--modal-recall"
							data-fancybox-default) Заказать консультацию
						.cardoffer__footer__share.order-2.order-lg-4
							include ../components/_share
						div.order-5: a.mbtn.mbtn__middle.mbtn__wicon.mbtn__bordered.mbtn__light(href="#")
							i: +svg('ic-arrow-left-short')
							span другие размеры


		section.block__padd: .container
			.block__title
				h2.h2 Вам также может понравиться

			.slidercatalog
				.slidercatalog__offset.js--sl-catalog-offset
				.slidercatalog__body
					.slidercatalog__slider.swiper.js--sl-catalog
						.swiper-wrapper

							-for (let i = 0; i < 6; i++)
								// el
								.slidercatalog__slider__item.swiper-slide
									+mixin__poructCard(i, pr_title[i], pr_price[i], pr_priceold[i], pr_description[i], pr_storage[i])
								// /el


	// footer
	include ../section/footer/footer
	// end footer

block modals
	include ../section/modals/modals
