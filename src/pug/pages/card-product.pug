										img(src=`${baseDir}img/card/img-product-text-0.jpg`, alt="")

										p Felis leo faucibus proin tellus sed adipiscing morbi malesuada ipsum. Sed mauris metus faucibus pretium cras sed. Non sagittis auctor tempor a pellentesque molestie ac. Tempus montes vitae fermentum dui in. Neque facilisi viverra egestas orci aliquam pellentesque pulvinar nullam mattis. Consectetur sed felis curabitur sed adipiscing vel facilisis semper.

										img(src=`${baseDir}img/card/img-product-text-1.jpg`, alt="")

								.col-12.col-lg-5.order-1.order-lg-2
									.content-columns__advantageslist

										// el
										.content-columns__advantageslist__card.style__brown
											i: img(src=`${baseDir}img/card/ic-advantage-1.svg`, alt="")
											span Устойчив к повреждениям
										// /el

										// el
										.content-columns__advantageslist__card.style__green
											i: img(src=`${baseDir}img/card/ic-advantage-2.svg`, alt="")
											span Устойчив к пятнам
										// /el

										// el
										.content-columns__advantageslist__card.style__yellow
											i: img(src=`${baseDir}img/card/ic-advantage-3.svg`, alt="")
											span УФ стойкость
										// /el

										// el
										.content-columns__advantageslist__card.style__purple
											i: img(src=`${baseDir}img/card/ic-advantage-4.svg`, alt="")
											span Высокая термостойкость
										// /el

									.content-columns__properties
										h4.h4 характеристики
										-
											var c_property = [
												'Камень',
												'Цвет',
												'Страна',
												'Тип обработки',
												'Производитель',
												'Тип',
												'Прочность по шкале Мооса',
												'Плотность',
												'Водопоглащение',
												'Морозостойкость',
												'Термостойкость',
												'Кислотостойкость',
												'Возможность переполировки',
												'Истираемость',
											]
											var c_value = [
												'Кварцевый агломерат',
												'Серый',
												'Россия',
												'Полированный',
												'ALEPHSTONE',
												'Слэб 20 мм, полоса',
												'6-7',
												'2.6-2.7 т/м³',
												'0.15-0.30%',
												'300 циклов',
												'до 600 °C',
												'Высокая',
												'да',
												'0.12',
											]

										.content-columns__properties__list
											- for (let i = 0; i < c_property.length; i++)
												- var property = c_property[i]
												- var value = c_value[i]
												.content-columns__properties__list__item
													span=property
													span=value

					//- tab 2
					.tabs__content__item.js--tabs-item#tab-2
						.tabs__content__item__content
							.list-downloads

								// el
								a.list-downloads__card(href="#", download="File Name")
									span.list-downloads__card__icon: +svg('ic-pdf')
									span.list-downloads__card__title
										span.list-downloads__card__title__name Название документа
										span.list-downloads__card__title__size pdf, 14 Мб
									span.list-downloads__card__download: +svg('ic-download')
								// /el

								// el
								a.list-downloads__card(href="#", download="File Name")
									span.list-downloads__card__icon: +svg('ic-jpg')
									span.list-downloads__card__title
										span.list-downloads__card__title__name Название документа
										span.list-downloads__card__title__size pdf, 14 Мб
									span.list-downloads__card__download: +svg('ic-download')
								// /el

								// el
								a.list-downloads__card(href="#", download="File Name")
									span.list-downloads__card__icon: +svg('ic-excel')
									span.list-downloads__card__title
										span.list-downloads__card__title__name Название документа
										span.list-downloads__card__title__size pdf, 14 Мб
									span.list-downloads__card__download: +svg('ic-download')
								// /el

								// el
								a.list-downloads__card(href="#", download="File Name")
									span.list-downloads__card__icon: +svg('ic-doc')
									span.list-downloads__card__title
										span.list-downloads__card__title__name Название документа
										span.list-downloads__card__title__size pdf, 14 Мб
									span.list-downloads__card__download: +svg('ic-download')
								// /el

					//- tab 3
					.tabs__content__item.js--tabs-item#tab-3
						.tabs__content__item__content
							.content-columns: .row
								.col-12.col-lg-7.order-2.order-lg-1
									.block__text
										p Lorem ipsum dolor sit amet consectetur. Nunc commodo aliquam consectetur placerat augue sit sit. Volutpat magna scelerisque massa pulvinar vitae ipsum morbi. Dictum sapien cursus et ultrices rhoncus lorem gravida lorem. Lectus cras vehicula faucibus duis nullam. Elit id eget integer elementum ultricies. Semper molestie quam massa aliquam non.
										p Felis leo faucibus proin tellus sed adipiscing morbi malesuada ipsum. Sed mauris metus faucibus pretium cras sed. Non sagittis auctor tempor a pellentesque molestie ac. Tempus montes vitae fermentum dui in. Neque facilisi viverra egestas orci aliquam pellentesque pulvinar nullam mattis. Consectetur sed felis curabitur sed adipiscing vel facilisis semper.

										img(src=`${baseDir}img/card/img-text-0.jpg`, alt="")

										p Felis leo faucibus proin tellus sed adipiscing morbi malesuada ipsum. Sed mauris metus faucibus pretium cras sed. Non sagittis auctor tempor a pellentesque molestie ac. Tempus montes vitae fermentum dui in. Neque facilisi viverra egestas orci aliquam pellentesque pulvinar nullam mattis. Consectetur sed felis curabitur sed adipiscing vel facilisis semper.
								.col-12.col-lg-5.order-1.order-lg-2
									.content-columns__attation
										.content-columns__attation__header
											div.content-columns__attation__header__icon
												img(src=`${baseDir}img/icons/ic-attation.svg`, alt="")
											div.content-columns__attation__header__title
												h4.h4 Обратите внимание
										.content-columns__attation__content
											.block__text: p Lorem ipsum dolor sit amet consectetur. Nunc commodo aliquam consectetur placerat augue sit sit. Volutpat magna scelerisque massa pulvinar vitae ipsum morbi. Dictum sapien cursus et ultrices rhoncus lorem gravida lorem. Lectus cras vehicula faucibus duis nullam.



					//- tab 4
					.tabs__content__item.js--tabs-item#tab-4
						.tabs__content__item__content
							.projects-list
								- var projects = [{ marker: 'Гостиницы и рестораны', name: 'GRAND HOTEL ANAPA' }, { marker: 'Благоустройство ЖК', name: 'ЖК «Седьмой Континент»' }, { marker: 'Частные дома', name: 'Коттедж в г. Краснодаре' }]

								mixin projectCard(project, index)
									// el
									.projects-list__item
										a.projects__slider__card(href="#")
											span.projects__slider__card__image
												img(src=`${baseDir}img/projects/img-project-${index}.png`, alt="")
											span.projects__slider__card__body
												span.projects__slider__card__title
													span.projects__slider__card__title__marker=project.marker
													span.projects__slider__card__title__name=project.name
									// /el

								- for (let index = 0; index < projects.length; index++)
									- var project = projects[index]
									+projectCard(project, index)

								- for (let index = 0; index < projects.length; index++)
									- var project = projects[index]
									+projectCard(project, index)

							.block__more: .row.justify-content-center: .col-12.col-lg-auto
								a.mbtn.mbtn__grey.mbtn__wicon.mbtn__middle(href="#")
									span Смотреть все проекты
									i: +svg('ic-arrow-right')

		section.block__padd: .container
			.block__title
				h2.h2 Вам также может понравиться

			.slidercatalog
				.slidercatalog__offset.js--sl-catalog-offset
				.slidercatalog__body
					.slidercatalog__slider.swiper.js--sl-catalog
						.swiper-wrapper

							-for (let i = 0; i < 6; i++)
								// el
								.slidercatalog__slider__item.swiper-slide
									+mixin__poructCard(i, pr_title[i], pr_price[i], pr_priceold[i], pr_description[i], pr_storage[i])
								// /el


	// footer
	include ../section/footer/footer
	// end footer

block modals
	include ../section/modals/modals
