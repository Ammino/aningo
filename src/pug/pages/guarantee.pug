extends ../layouts/default

prepend vars

block content

	// header start
	include ../section/header/header
	// header end

	// search
	include ../section/header/_search
	// /search

	main#main.main

		section.pageinside.pageinside__last: .container
			+crumbsBlock()
				li: a.crumbs__link(href="home.html" target="_blank") Главная
				li: span Гарантия

			h1.h1 Гарантия
			.block__text
				p Наша компания предоставляет сервисное обслуживание изделия в течение всего гарантийного срока при соблюдении правил эксплуатации. Предметом гарантии является качество изготовления, сборки и установки изделия, качество материалов использованных при изготовлении. Срок гарантии – 12 месяцев с момента установки изделия, отметка о дате установки производится установщиком в Акте приема-передачи. На материал предоставляется гарантия 10 лет при условии правильной эксплуатации изделия. Во избежание возможных недоразумений, сохраняйте в течение срока эксплуатации изделия настоящий гарантийный талон с отметкой продавца о дате продажи.

				h3 Технические условия эксплуатации изделий, условия предоставления и сохранения гарантии
				p Изделия должны храниться в помещении с нормальными климатическими условиями: хранение и эксплуатация изделий полностью исключена в помещении с повышенной влажностью и резкими перепадами температуры. При хранении и эксплуатации изделий должны быть приняты меры, исключающие любые механические повреждения изделий.

				h3 Гарантия на изделия не предоставляется:
				ol
					li При наличии механических и иных повреждений изделий, связанных с небрежной эксплуатацией или хранением изделий
					li При проведении ремонта изделий лицами, не имеющими специального письменного Согласования с Подрядчиком.
					li В случае выполнения работ по установке изделий или их доставке Заказчиком самостоятельно.
					li Гарантия не распространяется на участок столешницы над посудомоечной машиной, не защищенный Заказчиком специальной лентой (диффузионный барьер), которая идет в комплекте с посудомоечной машиной и является защитой столешницы от конденсата и горячего пара. Установка ленты производится мастером по установке встроенной техники либо силами Заказчика.

	// footer
	include ../section/footer/footer
	// end footer

block modals
	include ../section/modals/modals
