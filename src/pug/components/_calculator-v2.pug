.calculator-card.js--calculator2
	form.form.js--calculator2-form(action="#" novalidate)

		//- Шаг 1, Выбор формы и размера подоконников
		include calculate2/step1

		//- Шаг 2, Выбор камня
		include calculate2/step2
		//- Шаг 3, Просмотр и подтверждение
		include calculate2/step3

		//- Шаг 4, Выбор фаски
		include calculate2/step4
		//- Шаг 5, Выбор дополнительных опций
		include calculate2/step5
		//- Шаг 6, Расчет
		include calculate2/step6

		.calculator-card__footer.js--calculator-card-footer
			.calculator-card__rezult__summ.js--calculator-card-rezult-summ
				.calculator-card__rezult__summ__price
					| Стоимость
					span.js--result-steptotal
					| ₽
					span: sup *
				.calculator-card__rezult__summ__info
					| <sup>*</sup> Ориентировочная стоимость, не является офертой!

			.calculator-card__footer__btns
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__white.js--calculator2-prev(type="button")
					i: +svg('ic-arrow-left-short')
					span.js--calculator2-prev-text Назад
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__primary.js--calculator2-next(type="button")
					span.js--calculator2-next-text Дальше
					i: +svg('ic-arrow-right-short')

				div.calculator-card__footer__share.js--calculator-share.hidden
					div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__grey(type="button")
						span скачать расчЁт в pdf
						i: +svg('ic-downloads')
					div
						include ../components/_share

			.calculator-card__footer__pagination
				.modal-questionnaire__footer__pagination__line: i.js--calculator2-progress(style="width: 17%;")
				.modal-questionnaire__footer__pagination__counter.js--calculator2-counter 1/6

		.calculator-card__formsend.js--calculator2-formsend.hidden
			.js--calculator1-formsend__body
				h3.h3.calculator-card__formsend__title Заявка отправлена
				.calculator-card__formsend__text Наши менеджеры скоро вам позвонят. Спасибо, что выбрали нас!
			.calculator-card__footer__btns
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__primary(type="button")
					span поделиться расчЁтом
					i: +svg('ic-share')
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__grey(type="button")
					span скачать расчЁт в pdf
					i: +svg('ic-downloads')
