.calculator-card.js--calculator1
	form.form(action="#")

		//- Шаг 1, Выбор формы и размера подоконников
		include calculate2/step1

		//- Шаг 2, Выбор камня
		include calculate2/step2
		//- Шаг 3, Просмотр и подтверждение
		include calculate2/step3

		//- Шаг 4, Выбор фаски
		include calculate2/step4
		//- Шаг 5, Выбор дополнительных опций
		include calculate2/step5
		//- Шаг 6, Расчет
		include calculate2/step6

		.calculator-card__footer
			.calculator-card__footer__btns
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__bordered.mbtn__white.js--calculator2-prev(type="button")
					i: +svg('ic-arrow-left-short')
					span.js--calculator1-prev-text Назад
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__primary.js--calculator2-next(type="submit")
					span.js--calculator1-next-text Дальше
					i: +svg('ic-arrow-right-short')
			.calculator-card__footer__pagination
				.modal-questionnaire__footer__pagination__line: i.js--calculator2-progress(style="width: 33%;")
				.modal-questionnaire__footer__pagination__counter.js--calculator2-counter 1/9
