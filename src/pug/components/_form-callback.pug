section.block__padd: .container
	.form-wrapper
		picture.form-wrapper__bg.js--bgparallax(data-parallax="120")
			source(srcset=`${baseDir}img/contacts/bg-form-mobile-0.jpg` media="(max-width: 991px)")
			img(src=`${baseDir}img/contacts/bg-form-0.jpg`, alt="")
		.form-wrapper__content
			h2.h2.form-wrapper__title Связяться с&nbsp;нами
			.form-wrapper__text: .block__text
				p Хотите обсудить выгодные условия сотрудничества?
				p Свяжитесь с нами удобным для вас способом или заполните форму обратной связи и наш менеджер свяжется с вами.
			.form-wrapper__contacts
				.form-wrapper__contacts__card
					.form-wrapper__contacts__card__label Телефон
					.form-wrapper__contacts__card__value
						a(href="tel:+79180000000") 8 (800) 770-01-06
				.form-wrapper__contacts__card
					.form-wrapper__contacts__card__label Email
					.form-wrapper__contacts__card__value
						a(href="mailto:aningo@aningo.ru") aningo@aningo.ru
		.form-wrapper__aside
			form.form.form__white
				.form__line.row
					.col-12
						label.form-input
							input.form-input__text.js--input-text(
								type="text", 
								name="NAME",
								required)
							span.form-input__label Ваше имя
						// .form__info.error Текст ошибки
					.col-12
						label.form-input
							input.form-input__text.js--input-text.js--maskphone(
								type="tel", 
								name="PHONE",
								required)
							span.form-input__label Телефон
						// .form__info.error Текст ошибки
					.col-12
						label.form-input
							input.form-input__text.js--input-text(
								type="text", 
								name="EMAIL",
								required)
							span.form-input__label E-mail
						// .form__info.error Текст ошибки
				.form__line2.row
					.col-12
						label.form-checkbox.form-checkbox__small(for="check-d1")
							input.form-checkbox__input(type="checkbox" id="check-d1" required)
							span.form-checkbox__text 
								| Соглашаюсь на&nbsp;обработку 
								a(href="#", target="_blank", rel="noopener noreferrer") персональных данных 
								| в&nbsp;соответствии с&nbsp;
								a(href="#", target="_blank", rel="noopener noreferrer") политикой конфиденциальности.
					.col-12
						button.mbtn.mbtn__primary.mbtn__middle.d-block.w-100(type="submit") Отправить