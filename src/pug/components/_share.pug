mixin shareMenu()
	.block-share__dropdown
		.block-share__dropdown__body
			ul.block-share__list
				li: a.block-share__list__link(href="#", target="_blank")
					i: +svg('ic-telegram')
					span Telegram
				li: a.block-share__list__link(href="#", target="_blank")
					i: +svg('ic-whatsapp')
					span WhatsApp
				li: a.block-share__list__link(href="#", target="_blank")
					i: +svg('ic-max')
					span Max
				li: a.block-share__list__link(href="#", target="_blank")
					i: +svg('ic-vk')
					span ВКонтакте
				li: a.block-share__list__link(href="#", target="_blank")
					i: +svg('ic-link')
					span Копировать ссылку
				li: a.block-share__list__link(href="#", target="_blank")
					i: +svg('ic-downloads')
					span Сохранить в PDF

if !shareMenuOnly
	.block-share
		.block-share__label: +svg('ic-share')
		+shareMenu()
