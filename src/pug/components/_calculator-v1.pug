.calculator-card.js--calculator1
	form.form(action="#")

		//- Шаг 1, Выбор формы столешницы
		include calculate1/step1
		//- Шаг 2, Настройки столешницы
		include calculate1/step2
		//- Шаг 3, Выбор барной стойки
		include calculate1/step3
		//- Шаг 4, Выбор острова
		include calculate1/step4
		//- Шаг 5, Выбор камня
		include calculate1/step5
		//- Шаг 6, Просмотр и подтверждение
		include calculate1/step6
		//- Шаг 7, Выбор фаски
		include calculate1/step7
		//- Шаг 8, Выбор дополнительных опций
		include calculate1/step8
		//- Шаг 9, Расчет
		include calculate1/step9

		.calculator-card__footer
			.calculator-card__footer__btns
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__bordered.mbtn__white.js--calculator1-prev(type="button")
					i: +svg('ic-arrow-left-short')
					span.js--calculator1-prev-text Назад
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__primary.js--calculator1-next(type="submit")
					span.js--calculator1-next-text Дальше
					i: +svg('ic-arrow-right-short')
			.calculator-card__footer__pagination
				.modal-questionnaire__footer__pagination__line: i.js--calculator1-progress(style="width: 33%;")
				.modal-questionnaire__footer__pagination__counter.js--calculator1-counter 1/9
