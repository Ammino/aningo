.calculator-card.js--calculator1
	form.form(action="#")

		// Шаг 1, Выбор формы столешницы
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Выберите форму столешницы для кухни
				.calculator-card__header__text: .block__text
					p Форма столешницы соотвествует конструкции вашего кухонного гарнитура и бывает 3 основных видов: прямая, L-образная(угловая) и U-образная.

			.calculator-card__content
				.calculator-card__columns3

					// el
					.calculator-card__columns3__item
						label.calculator-card__radioblock
							input.calculator-card__radioblock__input(
								name="form-tabletop"
								type="radio",
								checked)
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text Прямая
								span.calculator-card__radioblock__img
									img(
										src=`${baseDir}img/calculator/img-calc-tabletop-0.jpg`,
										alt="")
					// /el

					// el
					.calculator-card__columns3__item
						label.calculator-card__radioblock
							input.calculator-card__radioblock__input(
								name="form-tabletop"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text L-образная
								span.calculator-card__radioblock__img
									img(
										src=`${baseDir}img/calculator/img-calc-tabletop-1.jpg`,
										alt="")
					// /el

					// el
					.calculator-card__columns3__item
						label.calculator-card__radioblock
							input.calculator-card__radioblock__input(
								name="form-tabletop"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text U-образная
								span.calculator-card__radioblock__img
									img(
										src=`${baseDir}img/calculator/img-calc-tabletop-2.jpg`,
										alt="")
					// /el
		// /Шаг 1

		// Шаг 2, Размеры столешницы
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Укажите размеры столешницы в миллиметрах
				.calculator-card__header__text: .block__text
					p Отметьте наличие на столешнице скосов или скруглений, а также вырезы под мойку и варочную панель.

			.calculator-card__content

		// /Шаг 2

		// Шаг 3, Выбор наличия барной стойки
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Выберите наличие барной стойки
				.calculator-card__header__text: .block__text
					p Если в вашей кухне присутсвует барная стойка, то её столешница также может быть изготовлена из натурального камня - добавьте к расчёту барную стойку. Выберите параметры барной стойки или нажмите "Далее", чтобы пропустить это шаг

			.calculator-card__content

				.calculator-card__columns4

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid4
							input.calculator-card__radioblock__input(
								name="form-barcounter"
								type="radio",
								checked)
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Без барной стойки
					// /el

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid2
							input.calculator-card__radioblock__input(
								name="form-barcounter"
								type="radio",
								data-sett="sett-0")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Плоская
								span.calculator-card__radioblock__img3
									img(
										src=`${baseDir}img/calculator/img-calc-barcounter-0.png`,
										alt="")
					// /el

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid2
							input.calculator-card__radioblock__input(
								name="form-barcounter"
								type="radio",
								data-sett="sett-1")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span L-образная
								span.calculator-card__radioblock__img3
									img(
										src=`${baseDir}img/calculator/img-calc-barcounter-1.png`,
										alt="")
					// /el

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid3
							input.calculator-card__radioblock__input(
								name="form-barcounter"
								type="radio",
								data-sett="sett-2")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span U-образная
								span.calculator-card__radioblock__img3
									img(
										src=`${baseDir}img/calculator/img-calc-barcounter-2.png`,
										alt="")
					// /el

				.calculator-card__settings

					.calculator-card__settings__content
						.row.form__line3
							.col-6.col-sm-4.col-xl-4.js--line-sett
								label.form-calc__label(for="inp-bar-0") Ширина (мм)<sup>*</sup>
								input#inp-bar-0.form-calc__input.js--sett-1.js--sett-2.js--sett-3(
									type="text",
									name="barcounter",
									value="600",
									required)
							.col-6.col-sm-4.col-xl-4.js--line-sett
								label.form-calc__label(for="inp-bar-1") Длина (мм)<sup>*</sup>
								input#inp-bar-1.form-calc__input.js--sett-1.js--sett-2.js--sett-3(
									type="text",
									name="barcounter",
									value="1800",
									required)
							.col-6.col-sm-4.col-xl-4.js--line-sett
								label.form-calc__label(for="inp-bar-2") Высота (мм)<sup>*</sup>
								input#inp-bar-2.form-calc__input.js--sett-2.js--sett-3(
									type="text",
									name="barcounter",
									value="750",
									required)
							.col-12.js--line-sett
								label.form-checkbox
									input.form-checkbox__input.js--sett-1(
										type="checkbox"
										name="barcounter")
									span.form-checkbox__text
										span Добавить скругление

					.calculator-card__settings__side
						.calculator-card__settings__img
							.calculator-card__settings__img__sett.js--sett-1
								img(
									src=`${baseDir}img/calculator/barcounter/straight-bar_480_360.png`,
									alt="")
							.calculator-card__settings__img__sett.js--sett-1
								img(
									src=`${baseDir}img/calculator/barcounter/radial-bar_480_360.png`,
									alt="")
							.calculator-card__settings__img__sett.js--sett-2
								img(
									src=`${baseDir}img/calculator/barcounter/l-shape-bar_480_360.png`,
									alt="")
							.calculator-card__settings__img__sett.js--sett-3
								img(
									src=`${baseDir}img/calculator/barcounter/u-shape-bar_480_360.png`,
									alt="")

		// /Шаг 3

		// Шаг 4, Выбор наличия острова
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Выберите наличие острова
				.calculator-card__header__text: .block__text
					p Если в вашей кухне присутсвует остров, то его столешница также может быть изготовлена из натурального камня - добавьте к расчету остров.

			.calculator-card__content

				.calculator-card__columns4

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid4
							input.calculator-card__radioblock__input(
								name="form-kitchenisland"
								type="radio",
								checked)
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Без острова
					// /el

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid3
							input.calculator-card__radioblock__input(
								name="form-kitchenisland"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Плоский
								span.calculator-card__radioblock__img3
									img(
										src=`${baseDir}img/calculator/img-calc-kitchenisland-0.png`,
										alt="")
					// /el

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid3
							input.calculator-card__radioblock__input(
								name="form-kitchenisland"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span L-образный
								span.calculator-card__radioblock__img3
									img(
										src=`${baseDir}img/calculator/img-calc-kitchenisland-1.png`,
										alt="")
					// /el

					// el
					.calculator-card__columns4__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid3
							input.calculator-card__radioblock__input(
								name="form-kitchenisland"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span U-образный
								span.calculator-card__radioblock__img3
									img(
										src=`${baseDir}img/calculator/img-calc-kitchenisland-2.png`,
										alt="")
					// /el

				.calculator-card__settings

					.calculator-card__settings__content
						.row.form__line3
							.col-6.col-sm-4.col-xl-4.js--line-sett
								label.form-calc__label(for="inp-bar-0") Ширина (мм)<sup>*</sup>
								input#inp-bar-0.form-calc__input.js--sett-1.js--sett-2.js--sett-3(
									type="text",
									name="island",
									value="600",
									required)
							.col-6.col-sm-4.col-xl-4.js--line-sett
								label.form-calc__label(for="inp-bar-1") Длина (мм)<sup>*</sup>
								input#inp-bar-1.form-calc__input.js--sett-1.js--sett-2.js--sett-3(
									type="text",
									name="island",
									value="1800",
									required)
							.col-6.col-sm-4.col-xl-4.js--line-sett
								label.form-calc__label(for="inp-bar-2") Высота (мм)<sup>*</sup>
								input#inp-bar-2.form-calc__input.js--sett-2.js--sett-3(
									type="text",
									name="barcounter",
									value="750",
									required)
							.col-12.js--line-sett
								.calculator-card__settings__listchecks
									div
										label.form-checkbox
											input.form-checkbox__input.js--sett-1(
												type="checkbox"
												name="island")
											span.form-checkbox__text
												span Добавить скругление углов

										.calculator-card__settings__listradios
											div
												label.form-radio
													input.form-radio__input(
														type="radio"
														name="radio")
													span.form-radio__text
														span 1
											div
												label.form-radio
													input.form-radio__input(
														type="radio"
														name="radio")
													span.form-radio__text
														span 2
											div
												label.form-radio
													input.form-radio__input(
														type="radio"
														name="radio")
													span.form-radio__text
														span 3
											div
												label.form-radio
													input.form-radio__input(
														type="radio"
														name="radio")
													span.form-radio__text
														span 4
									div
										label.form-checkbox
											input.form-checkbox__input.js--sett-1(
												type="checkbox"
												name="island")
											span.form-checkbox__text
												span Вырез под мойку в острове
									div
										label.form-checkbox
											input.form-checkbox__input.js--sett-1(
												type="checkbox"
												name="island")
											span.form-checkbox__text
												span Вырез под варочную панель в острове

					.calculator-card__settings__side
						.calculator-card__settings__img
							.calculator-card__settings__img__sett.js--sett-1
								img(
									src=`${baseDir}img/calculator/island/island-base_480_320.png`,
									alt="")
							.calculator-card__settings__img__sett.js--sett-1
								img(
									src=`${baseDir}img/calculator/island/island-base_480_320.png`,
									alt="")
							.calculator-card__settings__img__sett.js--sett-2
								img(
									src=`${baseDir}img/calculator/island/island-base_480_320.png`,
									alt="")
							.calculator-card__settings__img__sett.js--sett-3
								img(
									src=`${baseDir}img/calculator/island/island-base_480_320.png`,
									alt="")

		// /Шаг 4

		// Шаг 5, Выбор камня из каталога
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Выберите камень из нашего каталога

			.calculator-card__content

		// /Шаг 5

		// Шаг 6, вы выбрали
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title вы выбрали Кварцевый агломерат ANTRACITE

			.calculator-card__content

		// /Шаг 6

		// Шаг 7, Выбор фаски
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Выберите фаску

			.calculator-card__content

				.calculator-card__columns3

					// el
					.calculator-card__columns3__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid2
							input.calculator-card__radioblock__input(
								name="form-chamfer"
								type="radio",
								checked)
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Без фаски
									b бесплатно
								span.calculator-card__radioblock__img2
									img(
										src=`${baseDir}img/calculator/img-calc-chamfer-0.jpg`,
										alt="")
					// /el

					// el
					.calculator-card__columns3__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid2
							input.calculator-card__radioblock__input(
								name="form-chamfer"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Фаска сложная (полировка)
									b 6 200 ₽/пог.м.
								span.calculator-card__radioblock__img2
									img(
										src=`${baseDir}img/calculator/img-calc-chamfer-1.jpg`,
										alt="")
					// /el

					// el
					.calculator-card__columns3__item
						label.calculator-card__radioblock.calculator-card__radioblock__grid2
							input.calculator-card__radioblock__input(
								name="form-chamfer"
								type="radio")
							span.calculator-card__radioblock__content
								span.calculator-card__radioblock__text
									span Фаска простая (полировка)
									b 3 700 ₽/пог.м.
								span.calculator-card__radioblock__img2
									img(
										src=`${baseDir}img/calculator/img-calc-chamfer-2.jpg`,
										alt="")
					// /el

		// /Шаг 7

		// Шаг 8, Дополнительные опции
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title дополнительные опции

			.calculator-card__content

				.calculator-card__settings__listchecks
					div
						label.form-checkbox
							input.form-checkbox__input.js--sett-1(
								type="checkbox"
								name="dopoptions")
							span.form-checkbox__text
								span Вырез под розетку - 6 000 ₽
					div
						label.form-checkbox
							input.form-checkbox__input.js--sett-1(
								type="checkbox"
								name="dopoptions")
							span.form-checkbox__text
								span Вырез под смеситель/дозатор - 6 000 ₽
					div
						label.form-checkbox
							input.form-checkbox__input.js--sett-1(
								type="checkbox"
								name="dopoptions")
							span.form-checkbox__text
								span Замер - бесплатно для Краснодарского края, другие регионы - индивидуально.
					div
						label.form-checkbox
							input.form-checkbox__input.js--sett-1(
								type="checkbox"
								name="dopoptions")
							span.form-checkbox__text
								span Подклейка торца заподлицо - 7 250 ₽/пог.м.
					div
						label.form-checkbox
							input.form-checkbox__input.js--sett-1(
								type="checkbox"
								name="dopoptions")
							span.form-checkbox__text
								span Подклейка торца под 45° - 9 500 ₽/пог.м.

				.calculator-card__accent Монтаж и доставка индивидуально обговариваются с менеджером

		// /Шаг 8

		// Шаг 9, Расчет стоимости
		.calculator-card__step

			.calculator-card__header
				h3.h3.calculator-card__header__title Расчет стоимости

			.calculator-card__content
				.calculator-card__rezult

					.calculator-card__rezult__content
						.calculator-card__rezult__item
							h4.h4 Описание
							ul.calculator-card__rezult__list
								li
									span.label Форма
									span.text Прямая столешница
								li
									span.label Материал
									span.text Кварцевый агломерат ANTRACITE
								li
									span.label Страна
									span.text Италия
								li
									span.label Цвет
									span.text Серый
								li
									span.label Вид камня
									span.text Эксклюзив
								li
									span.label Толщина
									span.text Слэб 20мм
								li
									span.label Фаска
									span.text Фаска сложная (полировка)
								li
									span.label Площадь столешницы
									span.text 1.8 м<sup>2</sup>
								li
									span.label Ширина
									span.text 600 мм
								li
									span.label Длина
									span.text 3 000 мм

						.calculator-card__rezult__item
							h4.h4 Барная стойка
						.calculator-card__rezult__item
							h4.h4 Кухонный остров
						.calculator-card__rezult__item
							h4.h4 Услуги и опции

					.calculator-card__rezult__side
						.calculator-card__rezult__img
							img(src=`${baseDir}img/calculator/img-calc-tabletop-0.jpg`, alt="")
						.calculator-card__rezult__img
							img(src=`${baseDir}img/catalog/img-catalog-0.png`, alt="")
						.calculator-card__rezult__img
							img(src=`${baseDir}img/calculator/img-calc-barcounter-0.png`, alt="")
						.calculator-card__rezult__img
							img(src=`${baseDir}img/calculator/img-calc-kitchenisland-0.png`, alt="")

				.calculator-card__form
					h3.h3.calculator-card__header__title Оставьте свои контактные данные - мы вам перезвоним.
					.form
						.form__line.row
							.col-12.col-lg-6
								label.form-input
									input.form-input__text.js--input-text(
										type="text",
										name="NAME",
										required)
									span.form-input__label Ваше имя
								// .form__info.error Текст ошибки
							.col-12.col-lg-6
								label.form-input
									input.form-input__text.js--input-text.js--maskphone(
										type="tel",
										name="PHONE",
										required)
									span.form-input__label Телефон
								// .form__info.error Текст ошибки
						.form__line2.row
							.col-12
								label.form-checkbox.form-checkbox__small(for="#check-m2")
									input.form-checkbox__input(type="checkbox" id="#check-m2" required)
									span.form-checkbox__text
										| Соглашаюсь на&nbsp;обработку
										a(href="#", target="_blank", rel="noopener noreferrer") персональных данных
										| в&nbsp;соответствии с&nbsp;
										a(href="#", target="_blank", rel="noopener noreferrer") политикой конфиденциальности.

		// /Шаг 9

		.calculator-card__footer
			.calculator-card__footer__btns
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__bordered.mbtn__white.js--calculator1-prev(type="button")
					i: +svg('ic-arrow-left-short')
					span Назад
				div: button.mbtn.mbtn__middle.mbtn__wicon.mbtn__primary.js--calculator1-next(type="button")
					span Дальше
					i: +svg('ic-arrow-right-short')
			.calculator-card__footer__pagination
				.modal-questionnaire__footer__pagination__line: i.js--calculator1-progress(style="width: 33%;")
				.modal-questionnaire__footer__pagination__counter.js--calculator1-counter 1/3
