// Шаг 5, Дополнительные опции
.calculator-card__step.hidden

	.calculator-card__header
		h3.h3.calculator-card__header__title дополнительные опции

	.calculator-card__content

		.calculator-card__settings__listchecks.js--droplist
			div
				label.form-checkbox
					input.form-checkbox__input.js--sett-1(
						type="checkbox"
						name="dopoptions",
						data-price="0")
					span.form-checkbox__text
						span Замер - Бесплатно для Краснодарского края, другие регионы - индивидуально.
			div
				label.form-checkbox
					input.form-checkbox__input.js--sett-1(
						type="checkbox"
						name="dopoptions",
						data-price="2000")
					span.form-checkbox__text
						span Ушки - 2 800 ₽
			div
				label.form-checkbox
					input.form-checkbox__input.js--sett-1(
						type="checkbox"
						name="dopoptions",
						data-price="3000")
					span.form-checkbox__text
						span Отверстие для конвекции - 3 000 ₽
			div
				label.form-radio
					input.form-radio__input.js--sett-1(
						type="radio"
						name="dopoptions-gluing",
						data-price="7250")
					span.form-radio__text
						span Подклейка торца заподлицо - 7 250 ₽/пог.м.
			div
				label.form-radio
					input.form-radio__input.js--sett-1(
						type="radio"
						name="dopoptions-gluing",
						data-price="9500")
					span.form-radio__text
						span Подклейка торца под 45° - 9 500 ₽/пог.м.

		.calculator-card__accent Монтаж и доставка индивидуально обговариваются с менеджером

