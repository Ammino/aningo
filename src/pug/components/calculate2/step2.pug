// Шаг 2, Выбор камня из каталога
.calculator-card__step.hidden

	.calculator-card__header
		h3.h3.calculator-card__header__title Выберите камень из нашего каталога

	.calculator-card__content

		.pageinside__columns.js--sidefilter-columns
			.pageinside__columns__sidebar.d-none.d-lg-block
				.sidefilter-btnshow.js--sidefilter-btnshow
					i: +svg('ic-filter')
					span Скрыть фильтры
					span.d-none Показать фильтры

			.pageinside__columns__body
				.catalog__line
					// поиск по каталогу
					.catalog__search
						form.catalog__search__form(action="#")
							input.catalog__search__input(
								type="search"
								placeholder="Поиск")
							//- button.catalog__search__submit(type="submit")
					// /поиск

					// сортировка
					.catalog__sort
						.catalog__sort__item.d-lg-none
							a.filter-btnopen.js--filter-btnopen(href="#")
								+svg('ic-filter')
						.catalog__sort__item
							.nselect.nselect-wmobversion.js--nselect
								.nselect__label.js--nselect-label(data-text="Сортировать по:")
									i.icon: +svg('ic-sort')
									span.text.js--nselect-label-text Сортировать по:
								.nselect__dropdown.nselect__dropdown__rightdropdown.js--nselect-dropdown
									.nselect__dropdown__body.js--styled-scroll
										ul
											li: a.nselect__dropdown__item.js--nselect-option.default(href="#") Все
											li: a.nselect__dropdown__item.js--nselect-option(href="#") Сначала дешевле
											li: a.nselect__dropdown__item.js--nselect-option(href="#") Сначала дороже
											li: a.nselect__dropdown__item.js--nselect-option(href="#") По популярности
											li: a.nselect__dropdown__item.js--nselect-option(href="#") По новизне
					// /сортировка

			.pageinside__columns__sidebar.js--sidefilter-sidebar
				include ../_sidefilter

			.pageinside__columns__body

				// Результат фильтрации
				.catalog__filterr-result
					.catalog__filterr-result__item
						.catalog__filterr-result__label Найдено: 351
					.catalog__filterr-result__item
						.catalog__filterr-result__card
							span Пропускает свет
							i: +svg('ic-close')
					.catalog__filterr-result__item
						.catalog__filterr-result__card
							span Камень: Кварцит
							i: +svg('ic-close')
					.catalog__filterr-result__item
						.catalog__filterr-result__card
							span Цвет: Серый
							i: +svg('ic-close')
					.catalog__filterr-result__item
						.catalog__filterr-result__card
							span Страна: Бразилия
							i: +svg('ic-close')
					.catalog__filterr-result__item
						.catalog__filterr-result__card
							span Тип обработки: полированный.
							i: +svg('ic-close')
					.catalog__filterr-result__item
						button.catalog__filterr-result__clear(type="button")
							| Сбросить фильтры
				// /Результат фильтрации

				// каталог товаров
				.catalog-list

					- for (let i = 0; i < 6; i++)
						// el
						.catalog-list__item
							+mixin__mainCardCalculate(i, m_title[i], m_description[i], m_storage[i])
						// el

				// /каталог товаров

				.block__more: .row
					.col-12
						a.mbtn.mbtn__white.mbtn__middle.d-block.w-100(href="#") Показать еще
					.col-12
						include ../_pagination

// /Шаг 2
