							.calc-windowsill__cardcart__img
								img(src=`${baseDir}img/calculator/windowsill/windowsill-0.jpg`, alt="")
							.calc-windowsill__cardcart__body
								.calc-windowsill__cardcart__name Прямой
								ul.calc-windowsill__cardcart__list
								.calc-windowsill__cardcart__footer
									div
										.form-inputcount.js--inputcount
											button.form-inputcount__btn.minus.js--inputcount-minus(type="button")
												+svg('ic-minus')
											button.form-inputcount__btn.plus.js--inputcount-plus(type="button")
												+svg('ic-plus')
											input.form-inputcount__input.js--inputcount-input(
												type="number",
												name="windowsill-quantity",
												min="1",
												max="100",
												value="1")
